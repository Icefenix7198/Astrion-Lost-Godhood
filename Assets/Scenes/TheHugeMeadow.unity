--- !u!114 &1531983958
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1531983946}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f608b8c9fb3044200aac956492d8d586, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 104
  indentLevel: 0
  conversationText:
    stringRef: {fileID: 0}
    stringVal: "lorelai NPC right: Vale, vale, antes de que mi cerebro explote\u2026
      Preguntas. Muchas. \xA1Demasiadas! N\xFAmero uno: \xBFC\xF3mo se siente ser
      un dios? \xBFEs como ser humano pero m\xE1s, o es completamente distinto? \xBFSientes
      el viento aunque no est\xE9 soplando? \xBFO lo eres? \xBFPuedes escuchar las
      nubes moverse? \xBFLas tormentas te hablan?\n\nastrion astrion_mc left: Hmm\u2026
      muchas preguntas. A ver\u2026 Ser un dios. Es\u2026 como ser el cielo. Est\xE1s
      ah\xED. Siempre. No cambia mucho. \xBFY luego que si escucho las nubes hablar?
      Pues realmente no, solo puedo controlarlas, bueno, pod\xEDa\u2026 Ya me he
      olvidado del resto de cosas que me has preguntado\u2026\n\nlorelai NPC right:
      Y ya estar\xEDamos, este es el pueblo, yo me quedo aqu\xED que ahora mismo
      est\xE1n los soldados del mago de estas praderas. Ten cuidado.\nlorelai hide:\n\nsoldado
      right: \xA1Alto ah\xED! \xA1\xBFQui\xE9n eres?! \xA1\xBFDe d\xF3nde vienes?!
      El paso est\xE1 restringido.\n\nastrion astrion_mc hide:\r\nsoldado right hide:
      \n"
  clearPrevious:
    booleanRef: {fileID: 0}
    booleanVal: 1
  waitForInput:
    booleanRef: {fileID: 0}
    booleanVal: 1
  waitForSeconds:
    floatRef: {fileID: 0}
    floatVal: 0
  fadeWhenDone:
    booleanRef: {fileID: 0}
    booleanVal: 1
